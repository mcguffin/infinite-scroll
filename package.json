{
  "name": "infinite-scroll",
  "version": "0.0.0",
  "description": "",
  "author": "mcguffin",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "build": "wp-scripts build src/index.js src/front.js",
    "start": "wp-scripts start src/index.js src/front.js",
    "setversion": "PVER=$(node -e \"console.log(require('./package.json').version);\") && echo \"<?php return '$PVER';\" > ./include/version.php"
  },
  "devDependencies": {
    "@wordpress/scripts": "^28.6.0",
    "@babel/runtime": "^8.0.5"
  },
  "wporg": {
    "steps": [
      "build",
      "git",
      "github"
    ],
    "type": "plugin",
    "build": {
      "versionedFiles": null,
      "prebuild": [],
      "build": [
        "npm run setversion"
      ]
    },
    "git": {
      "host": "github.com",
      "user": "mcguffin"
    },
    "wporg": {
      "assets": ".wporg",
      "svn_user": "podpirate"
    }
  }
}